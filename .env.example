# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Host port mapped to the backend container (change if 8000 is taken locally;
# keep VITE_API_URL in sync)
BACKEND_HOST_PORT=8000
# Origins allowed to call the API from the browser (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=mri
POSTGRES_USER=mri
POSTGRES_PASSWORD=mri
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port mapped to the postgres container (change if 5432 is taken locally)
POSTGRES_HOST_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Orthanc
# URL used by the backend (inside the docker network)
ORTHANC_URL=http://orthanc:8042
# Base of OHIF viewer links opened by the browser – the gateway (keep in sync with GATEWAY_HOST_PORT)
ORTHANC_PUBLIC_URL=http://localhost:8080
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc
ORTHANC_GATEWAY_AUTH=b3J0aGFuYzpvcnRoYW5j

# Frontend (Vite) – backend API base URL as seen from the browser
VITE_API_URL=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-change-me
S3_ENDPOINT_URL=http://minio:9000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-change-me

GATEWAY_HOST_PORT=8080

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# LLM – OpenAI-compatible API, local only
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=bielik-7b-instruct
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,llm-server
LLM_MODEL_FILE=bielik.gguf

# nnU-Net
nnUNet_raw=/data/nnunet/raw
nnUNet_preprocessed=/data/nnunet/preprocessed
nnUNet_results=/data/nnunet/results

# Storage plików
FILE_STORAGE_ROOT=/data
CUDA_VISIBLE_DEVICES=0
