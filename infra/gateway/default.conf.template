# DICOMweb frames are addressed by study/series/instance UIDs and never change, so the browser may
# keep them on disk: a study opened once opens again without the download, even after a reload.
# Only for the logged-in browser (private) and for a day. Lists and metadata stay uncached, since a
# study can still get new series (a mask) under the same URL.
map $uri $dicom_cache_control {
    ~/frames/  "private, max-age=86400, immutable";
    default    "";
}

server {
    listen 80;
    client_max_body_size 2g;

    # Lossless compression for whatever the browser accepts gzip for, which matters on a slow uplink.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        application/javascript text/javascript text/css application/json application/wasm
        image/svg+xml;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ohif/ {
        auth_request /_auth/orthanc;
        proxy_pass http://orthanc:8042/ohif/;
        proxy_set_header Authorization "Basic ${ORTHANC_GATEWAY_AUTH}";
        proxy_hide_header WWW-Authenticate;
    }

    location /dicom-web/ {
        # Frames are raw pixel data and shrink ~2.5x on MRI. They come as
        # multipart/related; type=...; boundary=..., and nginx matches gzip_types against the whole
        # header (it strips only charset), so a "multipart/related" entry would never match.
        gzip_types *;
        add_header Cache-Control $dicom_cache_control;
        auth_request /_auth/orthanc;
        proxy_pass http://orthanc:8042/dicom-web/;
        proxy_set_header Authorization "Basic ${ORTHANC_GATEWAY_AUTH}";
        proxy_hide_header WWW-Authenticate;
    }

    location = /_auth/orthanc {
        internal;
        proxy_pass http://backend:8000/api/auth/orthanc;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        # DICOMweb clients send Accept: application/dicom+json, which DRF would answer with 406
        proxy_set_header Accept "*/*";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
    }

    location / {
        proxy_pass http://frontend:5173;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
